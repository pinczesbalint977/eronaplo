{
  "name": "eronaplo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:rules": "firebase emulators:exec --only firestore --project demo-eronaplo \"node --test tests/firestore.rules.test.mjs\"",
    "test:unit": "node --test tests/workouts.test.mjs tests/journal-changes.test.mjs tests/sessions.test.mjs tests/write-journal-batch.test.mjs tests/pwa-config.test.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-eronaplo \"playwright test\"",
    "test:pwa": "node --test tests/pwa-config.test.mjs",
    "check:deploy": "node scripts/check-deploy-env.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "6.2.1",
    "firebase-tools": "15.35.0",
    "sharp": "0.35.5",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0"
  }
}
